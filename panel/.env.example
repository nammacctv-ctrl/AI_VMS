# Names only. Never commit real values. Copy to .env on the server.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# base64 of 32 random bytes: openssl rand -base64 32. Back it up: losing it makes stored 2FA secrets unreadable.
APP_ENCRYPTION_KEY=
# Root domain that tenant subdomains hang off, e.g. panel.example.com
PLATFORM_ROOT_DOMAIN=
# From the Cloudflare Zero Trust dashboard: Networks > Tunnels > your tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# Optional: pin released, signed images instead of building locally
# PANEL_IMAGE_APP=
# PANEL_IMAGE_MIGRATE=
